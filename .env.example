# Copier ce fichier en .env et le remplir. .env est ignoré par Git.

# Client OAuth Google (type « Application de bureau »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Search Console : propriétés interrogeables, séparées par des virgules ; vide = toutes
# Ex. https://www.exemple.fr/,sc-domain:exemple.es
GSC_SITE_URLS=

# Google Ads (IDs à 10 chiffres, tirets acceptés)
# Compte administrateur (MCC) par lequel lire les comptes clients ; vide = accès direct
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comptes interrogeables, séparés par des virgules ; vide = tous
GOOGLE_ADS_CUSTOMER_IDS=
# Version de l'API (défaut v26)
# GOOGLE_ADS_API_VERSION=v26

# Bing Webmaster Tools : clé générée dans Bing Webmaster → Paramètres → Accès API
BING_API_KEY=
# Sites interrogeables, séparés par des virgules, écrits comme dans Bing Webmaster ; vide = tous
BING_SITE_URLS=
