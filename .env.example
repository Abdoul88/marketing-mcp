# Copier ce fichier en .env et le remplir. .env est ignoré par Git.

# Client OAuth Google (type « Application de bureau »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Search Console : propriétés interrogeables, séparées par des virgules ; vide = toutes
# Ex. https://www.exemple.fr/,sc-domain:exemple.es
GSC_SITE_URLS=

# Google Ads (IDs à 10 chiffres, tirets acceptés)
# Compte administrateur (MCC) par lequel lire les comptes clients ; vide = accès direct
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comptes interrogeables, séparés par des virgules ; vide = tous
GOOGLE_ADS_CUSTOMER_IDS=
# Version de l'API (défaut v26)
# GOOGLE_ADS_API_VERSION=v26

# Bing Webmaster Tools : clé générée dans Bing Webmaster → Paramètres → Accès API
BING_API_KEY=
# Sites interrogeables, séparés par des virgules, écrits comme dans Bing Webmaster ; vide = tous
BING_SITE_URLS=

# --- Dashboard et scripts (voir docs/dashboard.md) ---
# Port du dashboard (défaut 4321)
# DASHBOARD_PORT=4321
# Page Facebook : identifiant et jeton de Page longue durée (API Graph, gratuite)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v23.0
# IndexNow (Bing) : clé générée par « npm.cmd run indexnow -- --cle »
INDEXNOW_KEY=
# Firecrawl (facultatif) : crawl avec rendu JavaScript et benchmark du top 3 depuis le dashboard
# Clé gratuite sur https://firecrawl.dev ; sans clé, le crawl utilise le crawler interne gratuit.
FIRECRAWL_API_KEY=
# PageSpeed Insights (facultatif) : quota plus large pour les Core Web Vitals
# Clé sur https://console.cloud.google.com → API PageSpeed Insights ; sans clé, l'API reste utilisable avec un débit limité.
PAGESPEED_API_KEY=
