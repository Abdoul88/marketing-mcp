{
  "name": "marketing-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur MCP local en lecture seule (Search Console, Google Ads, Bing Webmaster) et dashboard SEO gratuit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "auth:google": "tsx --use-system-ca src/auth-google.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dashboard": "tsx --use-system-ca src/dashboard/server.ts",
    "charte": "tsx src/scripts/charte.ts",
    "visuel": "tsx src/scripts/visuel.ts",
    "facebook": "tsx src/scripts/facebook.ts",
    "discover": "tsx src/scripts/discover.ts",
    "indexnow": "tsx src/scripts/indexnow.ts",
    "wordpress": "tsx src/scripts/wordpress.ts",
    "suivi": "tsx src/scripts/suivi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Abdoul Diallo",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "seo",
    "sea",
    "google-search-console",
    "google-ads",
    "bing-webmaster"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdoul88/marketing-mcp.git"
  },
  "homepage": "https://github.com/Abdoul88/marketing-mcp#readme"
}
